---
---

<section class="bg-[#043873]">
  <div class="flex flex-col gap-[100px] items-center px-[16px] py-[80px] max-w-120 mx-auto">
    <img
      src="https://placehold.co/448x232/c4defd/ffffff"
      alt=""
      class="w-full h-auto"
    />
    <div class="flex flex-col gap-[60px] items-center">
      <div class="flex flex-col gap-[24px] items-center text-center text-white">
        <p class="font-bold text-[36px] tracking-[-0.02em]">
          Work with Your Favorite Apps Using whitepace
        </p>
        <p class="leading-[30px] text-[18px] tracking-[-0.02em]">
          Whitepace teams up with your favorite software. Integrate with over 1000+ apps with Zapier to have all the tools you need for your project success.
        </p>
      </div>
      <button class="bg-[#4f9cf9] flex gap-[10px] items-center justify-center px-[40px] py-[20px] rounded-[8px] cursor-pointer">
        <span class="leading-[30px] text-[18px] text-white tracking-[-0.02em]">
          Read more
        </span>
        <div class="flex items-start">
          <div class="relative size-[14px]">
            <div class="absolute inset-[-3.57%]">
              <svg class="block max-w-none size-full" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.5 7.5H13.5M13.5 7.5L7.5 1.5M13.5 7.5L7.5 13.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>
      </button>
    </div>
  </div>
</section>
