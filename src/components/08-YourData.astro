<section class="flex flex-col gap-25 items-center justify-center px-4 py-20 max-w-120 mx-auto">
  <img
    src="https://placehold.co/448x163/c4defd/ffffff"
    alt=""
    class="w-full h-40.75 object-cover"
  />
  <div class="flex flex-col gap-15 items-center">
    <div class="flex flex-col gap-6 items-center relative">
      <div class="absolute inset-[11.52%_-4.86%_79.85%_37.5%]">
        <svg class="block max-w-none size-full" viewBox="0 0 97 58" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M96.8789 57.1992C45.2656 57.1992 3.59375 44.0898 0.878906 0.199219" stroke="#FFE492" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="font-bold text-4xl text-center tracking-[-0.02em]">
        100% your data
      </p>
      <p class="leading-7.5 text-lg text-center tracking-[-0.02em]">
        The app is open source and your notes are saved to an open format, so you'll always have access to them. Uses End-To-End Encryption (E2EE) to secure your notes and ensure no-one but yourself can access them.
      </p>
    </div>
    <button class="bg-[#4f9cf9] flex gap-2.5 items-center justify-center px-10 py-5 rounded-lg cursor-pointer hover:bg-[#3d8ce8] transition-colors">
      <span class="leading-7.5 text-lg text-white tracking-[-0.02em]">
