---
const productLinks = [
  { text: "Overview", highlight: true },
  { text: "Pricing", highlight: false },
  { text: "Customer stories", highlight: false },
];

const resourceLinks = [
  { text: "Blog" },
  { text: "Guides & tutorials" },
  { text: "Help center" },
];

const companyLinks = [
  { text: "About us" },
  { text: "Careers " },
  { text: "Media kit" },
];

const footerLinks = [
  { text: "Terms & privacy" },
  { text: "Security" },
  { text: "Status" },
  { text: "©2021 Whitepace LLC." },
];
---

<footer class="bg-[#043873]">
  <div class="flex flex-col items-center justify-center pb-8 pt-35 px-4 max-w-120 mx-auto">
    <div class="flex flex-col gap-20 items-center justify-center">
      <div class="flex flex-col gap-20 items-center justify-center">
        <!-- Logo and description -->
        <div class="flex flex-col gap-6 items-center leading-0">
          <div class="grid-cols-[max-content] grid-rows-[max-content] inline-grid items-start justify-items-start">
            <div class="col-1 h-7.25 ml-0 mt-[2.5px] overflow-clip relative row-1 w-9.25">
              <img alt="" class="absolute inset-[-0.36%_0_0.35%_0] block max-w-none size-full" src="https://placehold.co/37x29/c4defd/ffffff" />
            </div>
            <p class="col-1 font-bold ml-[47px] mt-0 row-1 text-[28px] text-white">
              whitepace
            </p>
          </div>
          <div class="text-[#f7f7ee] text-[18px] text-center tracking-[-0.02em]">
            <p class="mb-0">
              <span class="leading-7.5">whitepace</span>
              <span class="leading-7.5"> was created for the new ways we live and work. </span>
            </p>
            <p class="leading-7.5">We make beautyfully designed around the world</p>
          </div>
        </div>

        <!-- Product section -->
        <nav class="flex flex-col gap-3.75 items-center justify-center text-[18px] text-center tracking-[-0.02em]">
          <p class="font-bold text-white">Product</p>
          {productLinks.map((link) => (
            <a href="#" class={`leading-7.5 ${link.highlight ? "text-[#ffe492]" : "text-white"} hover:text-[#ffe492] transition-colors`}>
              {link.text}
            </a>
          ))}
        </nav>

        <!-- Resources section -->
        <nav class="flex flex-col gap-4 items-center justify-center text-[18px] text-center text-white tracking-[-0.02em]">
          <p class="font-bold">Resources</p>
          {resourceLinks.map((link) => (
            <a href="#" class="leading-7.5 hover:text-[#ffe492] transition-colors">
              {link.text}
            </a>
          ))}
        </nav>

        <!-- Company section -->
        <nav class="flex flex-col gap-4 items-center justify-center text-[18px] text-center text-white tracking-[-0.02em]">
          <p class="font-bold">Company</p>
          {companyLinks.map((link) => (
            <a href="#" class="leading-7.5 hover:text-[#ffe492] transition-colors">
              {link.text}
            </a>
          ))}
        </nav>

        <!-- Try It Today section -->
        <div class="flex flex-col gap-5.75 items-center justify-center w-50.25">
          <p class="font-bold leading-9 text-[28px] text-center text-white tracking-[-0.02em]">
            Try It Today
          </p>
          <div class="leading-7.5 text-[18px] text-center text-white tracking-[-0.02em]">
            <p class="mb-0">Get started for free. </p>
            <p>Add your whole team as your needs grow.</p>
          </div>
          <button class="bg-[#4f9cf9] flex gap-2.5 items-center justify-center px-10 py-5 rounded-lg cursor-pointer">
            <span class="leading-7.5 text-[18px] text-white tracking-[-0.02em]">
              Start today
            </span>
            <div class="flex items-start">
              <div class="relative size-[14px]">
                <img alt="" class="absolute inset-[-3.57%] block max-w-none size-full" src="https://placehold.co/15x15/c4defd/ffffff" />
              </div>
            </div>
          </button>
        </div>
      </div>

      <!-- Bottom section -->
      <div class="flex flex-col gap-5 items-center justify-center">
        <div class="border-[#2e4e73] border-b border-solid flex flex-col gap-5 items-center justify-center pb-5 pt-0 px-0">
          <!-- Language selector -->
          <div class="flex gap-1.5 items-center justify-center">
            <div class="flex flex-col items-start">
              <div class="grid-cols-[max-content] grid-rows-[max-content] inline-grid items-start justify-items-start leading-0">
                <div class="col-1 h-[18.998px] ml-0 mt-0 row-1 w-[19px]">
                  <img alt="" class="block max-w-none size-full" src="https://placehold.co/19x19/c4defd/ffffff" />
                </div>
              </div>
            </div>
            <p class="leading-5 text-[16px] text-white tracking-[-0.02em]">
              English
            </p>
            <div class="h-[15px] w-[21px]">
              <img alt="" class="block max-w-none size-full" src="https://placehold.co/21x15/c4defd/ffffff" />
            </div>
          </div>

          <!-- Footer links -->
          {footerLinks.map((link) => (
            <a href="#" class="leading-5 text-[16px] text-white tracking-[-0.02em] hover:text-[#ffe492] transition-colors">
              {link.text}
            </a>
          ))}
        </div>

        <!-- Social icons -->
        <div class="flex gap-8 items-center">
          <a href="#" class="h-[16.684px] w-2.25">
            <img alt="Facebook" class="block max-w-none size-full" src="https://placehold.co/9x17/c4defd/ffffff" />
          </a>
          <a href="#" class="grid-cols-[max-content] grid-rows-[max-content] inline-grid items-start justify-items-start leading-0">
            <div class="col-1 h-[13.813px] ml-0 mt-0 row-1 w-4.25">
              <img alt="Twitter" class="block max-w-none size-full" src="https://placehold.co/17x14/c4defd/ffffff" />
            </div>
          </a>
          <a href="#" class="size-3.75">
            <img alt="LinkedIn" class="block max-w-none size-full" src="https://placehold.co/15x15/c4defd/ffffff" />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
