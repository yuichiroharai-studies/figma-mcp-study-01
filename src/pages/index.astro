---
import Layout from "../layouts/Layout.astro";
import Header from "../components/01-Header.astro";
import Hero from "../components/02-Hero.astro";
import Management from "../components/03-Management.astro";
import Extension from "../components/04-Extension.astro";
import Customise from "../components/05-Customise.astro";
import Plan from "../components/06-Plan.astro";
import YourWork from "../components/07-YourWork.astro";
import YourData from "../components/08-YourData.astro";
import Sponsors from "../components/09-Sponsors.astro";
import Apps from "../components/10-Apps.astro";
import Testimonial from "../components/11-Testimonial.astro";
import Trial from "../components/12-Trial.astro";
import Footer from "../components/13-Footer.astro";
---

